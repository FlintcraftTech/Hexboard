<?xml version="1.0" encoding="utf-8"?>
<!-- The input-method descriptor Android reads to list Hexboard in its keyboard picker.
     The settings activity is the app's own screen, which carries the button that opens
     the system's input-method settings. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="tech.flintcraft.hexboard.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/ime_subtype_label"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
</input-method>
